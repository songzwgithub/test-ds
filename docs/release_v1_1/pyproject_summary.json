{
  "name": "pypsds-gamma",
  "version": "1.0.0",
  "requires_python": ">=3.11",
  "dependencies": [
    "numpy>=1.26,<2.0",
    "scipy>=1.11,<1.13",
    "numba>=0.60,<0.67",
    "PyYAML>=6.0,<7",
    "threadpoolctl>=3.5,<4",
    "matplotlib>=3.8,<4"
  ],
  "scripts": {
    "pypsds": "pypsds.cli:main"
  },
  "build_system": {
    "requires": [
      "setuptools>=69",
      "wheel"
    ],
    "build-backend": "setuptools.build_meta"
  }
}
