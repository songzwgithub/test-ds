        "source": "if gamma_file.is_file():\n\n    gamma = np.fromfile(\n        gamma_file,\n        dtype=\">f4\",\n    ).astype(\n        np.float64\n    )\n\n\n    if gamma.size != N:\n        raise RuntimeError(\n            \"GAMMA truth size mismatch\"\n        )\n\n\n    m = (\n        valid\n        &\n        np.isfinite(gamma)\n        &\n        (gamma > 0)\n        &\n        (gamma < np.pi/2)\n    )\n\n\n    diff = np.degrees(\n        inc[m].astype(\n            np.float64\n        )\n        -\n        gamma[m]\n    )\n\n\n    ad = np.abs(\n        diff\n    )\n\n\n    rms = float(\n        np.sqrt(\n            np.mean(\n                diff\n                *\n                diff\n            )\n        )\n    )\n\n\n    p99 = float(\n        np.percentile(\n            ad,\n            99,\n        )\n    )\n\n\n    max_abs = float(\n        np.max(\n            ad\n        )\n    )\n\n\n    print()\n    print(\n        \"FAST vs GAMMA inc_flg=1\"\n    )\n\n    print(\n        \"RMS deg                  :\",\n        f\"{rms:.9f}\",\n    )\n\n    print(\n        \"p99 |di"
