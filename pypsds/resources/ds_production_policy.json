{
  "schema_version": 1,
  "name": "pyPSDS-GAMMA production defaults",
  "default_profile": {
    "final_ds": {
      "accept_evd": true,
      "pair_coherence_min": 0.0,
      "temporal_coherence_min": 0.8
    },
    "phase_linking": {
      "beta": 0.0,
      "evd_fallback": true,
      "gamma_jitter": 1e-06,
      "method": "robust_emi",
      "pair_policy": {
        "baseline_lag": null,
        "zero_correlation_threshold": 0.0
      },
      "target_eigenvalue": 0.99,
      "temporal": {
        "base_state_min_shp": 24,
        "full_scm_fallback": true,
        "max_num_compressed": 5,
        "ministack_size": 19,
        "strategy": "sequential"
      }
    },
    "shp": {
      "adaptive_window_capacity": true,
      "alpha": 0.005,
      "base_formal_min_shp": 48,
      "base_half_col": 11,
      "base_half_row": 5,
      "method": "rayleigh_glrt",
      "policy": "solver_aware",
      "rank_guard": true
    }
  },
  "quality_metrics": {
    "connected_shp": true,
    "crlb": true,
    "phase_linking_closure": true,
    "phase_similarity": true
  }
}
